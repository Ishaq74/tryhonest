---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('user.gdpr')}>
  <div class="max-w-4xl mx-auto space-y-6">
    <h1 class="text-4xl font-bold">{t('user.gdpr')}</h1>
    <p class="text-xl text-gray-600">Manage your personal data and privacy settings</p>

    <!-- GDPR Information -->
    <div class="bg-blue-50 border border-blue-200 p-6 rounded-lg">
      <h2 class="text-2xl font-bold mb-4">Your Data Rights (GDPR)</h2>
      <p class="text-gray-700 mb-4">
        Under the General Data Protection Regulation (GDPR), you have the following rights:
      </p>
      <ul class="list-disc list-inside space-y-2 text-gray-700">
        <li>Right to access your personal data</li>
        <li>Right to rectification of incorrect data</li>
        <li>Right to erasure ("right to be forgotten")</li>
        <li>Right to restrict processing</li>
        <li>Right to data portability</li>
        <li>Right to object to processing</li>
      </ul>
    </div>

    <!-- Data Export -->
    <div class="bg-white p-6 rounded-lg shadow-md">
      <h2 class="text-2xl font-bold mb-4">{t('user.export')}</h2>
      <p class="text-gray-600 mb-4">
        Download a copy of all your data stored in our system. This includes your profile information, 
        posts, comments, bookings, and activity history.
      </p>
      <button class="bg-blue-600 text-white px-6 py-3 rounded hover:bg-blue-700">
        Request Data Export
      </button>
      <p class="text-sm text-gray-500 mt-2">
        We'll prepare your data and send you a download link via email within 48 hours.
      </p>
    </div>

    <!-- Data Management -->
    <div class="bg-white p-6 rounded-lg shadow-md">
      <h2 class="text-2xl font-bold mb-4">Data Management</h2>
      <div class="space-y-4">
        <div class="border-b pb-4">
          <h3 class="font-bold mb-2">Profile Data</h3>
          <p class="text-gray-600 mb-2">Your account information and profile settings</p>
          <button class="text-blue-600 hover:underline">View & Edit</button>
        </div>
        <div class="border-b pb-4">
          <h3 class="font-bold mb-2">Activity History</h3>
          <p class="text-gray-600 mb-2">Your interactions, views, and activity on the platform</p>
          <button class="text-blue-600 hover:underline">View History</button>
        </div>
        <div class="border-b pb-4">
          <h3 class="font-bold mb-2">Communication Preferences</h3>
          <p class="text-gray-600 mb-2">Manage email and notification settings</p>
          <button class="text-blue-600 hover:underline">Manage Settings</button>
        </div>
        <div class="border-b pb-4">
          <h3 class="font-bold mb-2">Third-Party Data Sharing</h3>
          <p class="text-gray-600 mb-2">Control how your data is shared with third parties</p>
          <button class="text-blue-600 hover:underline">Manage Sharing</button>
        </div>
      </div>
    </div>

    <!-- Consent Management -->
    <div class="bg-white p-6 rounded-lg shadow-md">
      <h2 class="text-2xl font-bold mb-4">Consent Management</h2>
      <div class="space-y-4">
        <label class="flex items-center space-x-3">
          <input type="checkbox" checked class="rounded" />
          <span>I consent to the processing of my personal data as described in the Privacy Policy</span>
        </label>
        <label class="flex items-center space-x-3">
          <input type="checkbox" checked class="rounded" />
          <span>I consent to receiving marketing communications</span>
        </label>
        <label class="flex items-center space-x-3">
          <input type="checkbox" class="rounded" />
          <span>I consent to cookies and tracking for analytics purposes</span>
        </label>
        <button class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">
          Update Consent
        </button>
      </div>
    </div>

    <!-- Delete Account -->
    <div class="bg-red-50 border border-red-200 p-6 rounded-lg">
      <h2 class="text-2xl font-bold mb-4 text-red-800">Delete Account</h2>
      <p class="text-gray-700 mb-4">
        Permanently delete your account and all associated data. This action cannot be undone.
      </p>
      <button class="bg-red-600 text-white px-6 py-3 rounded hover:bg-red-700">
        Request Account Deletion
      </button>
    </div>
  </div>
</Layout>
