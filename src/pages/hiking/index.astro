---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('nav.hiking')}>
  <div class="space-y-6">
    <h1 class="text-4xl font-bold">{t('nav.hiking')}</h1>
    <p class="text-xl text-gray-600">Explore hiking trails with GPX files and geolocation</p>

    <!-- Hiking Trails Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {[1, 2, 3, 4].map((i) => (
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
          <div class="h-48 bg-gradient-to-br from-green-400 to-blue-500"></div>
          <div class="p-4">
            <h3 class="text-xl font-bold mb-2">Hiking Trail {i}</h3>
            <div class="space-y-2 text-gray-600 mb-4">
              <p>📏 Distance: 8.5 km</p>
              <p>⏱️ Duration: 2h 30min</p>
              <p>📈 Elevation: +450m</p>
              <p>💪 Difficulty: Moderate</p>
            </div>
            <div class="flex space-x-2 mb-4">
              {i === 1 && <span class="px-2 py-1 bg-blue-100 text-blue-800 rounded text-sm">♿ PMR</span>}
              <span class="px-2 py-1 bg-green-100 text-green-800 rounded text-sm">📍 Geolocated</span>
              <span class="px-2 py-1 bg-purple-100 text-purple-800 rounded text-sm">📥 GPX</span>
            </div>
            <div class="flex space-x-2">
              <button class="flex-1 bg-blue-600 text-white py-2 rounded hover:bg-blue-700">
                View Details
              </button>
              <button class="px-4 bg-green-600 text-white py-2 rounded hover:bg-green-700">
                Download GPX
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Map Section -->
    <div class="bg-white p-6 rounded-lg shadow-md">
      <h2 class="text-2xl font-bold mb-4">Trail Map</h2>
      <div class="h-96 bg-gray-200 rounded flex items-center justify-center">
        <p class="text-gray-500">Interactive map with GPX trails would be displayed here</p>
      </div>
    </div>
  </div>
</Layout>
