---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('nav.events')}>
  <div class="space-y-6">
    <h1 class="text-4xl font-bold">{t('nav.events')}</h1>

    <!-- Event Types -->
    <div class="flex space-x-4">
      <a href={`/${lang}/events`} class="px-4 py-2 bg-blue-600 text-white rounded-lg">
        {t('events.all')}
      </a>
      <a href={`/${lang}/events/festivals`} class="px-4 py-2 bg-gray-200 rounded-lg hover:bg-gray-300">
        {t('events.festivals')}
      </a>
      <a href={`/${lang}/events/live`} class="px-4 py-2 bg-gray-200 rounded-lg hover:bg-gray-300">
        {t('events.live')}
      </a>
    </div>

    <!-- Events Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {[1, 2, 3, 4, 5, 6].map((i) => (
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
          <div class="h-48 bg-gradient-to-br from-blue-400 to-purple-500"></div>
          <div class="p-4">
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-xl font-bold">Event {i}</h3>
              {i === 1 && <span class="px-2 py-1 bg-red-100 text-red-800 rounded text-sm">Live</span>}
            </div>
            <p class="text-gray-600 mb-2">📅 Date: TBD</p>
            <p class="text-gray-600 mb-4">📍 Location: Annecy</p>
            <button class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700">
              Learn More
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Live Events Section -->
    <div class="bg-white p-6 rounded-lg shadow-md">
      <h2 class="text-2xl font-bold mb-4">Live Updates</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="border-l-4 border-blue-500 pl-4">
          <h3 class="font-bold">🚦 Traffic Updates</h3>
          <p class="text-gray-600">Real-time traffic information</p>
        </div>
        <div class="border-l-4 border-green-500 pl-4">
          <h3 class="font-bold">🌤️ Weather</h3>
          <p class="text-gray-600">Current weather conditions</p>
        </div>
        <div class="border-l-4 border-purple-500 pl-4">
          <h3 class="font-bold">🎯 Promotions</h3>
          <p class="text-gray-600">Latest deals and offers</p>
        </div>
        <div class="border-l-4 border-orange-500 pl-4">
          <h3 class="font-bold">🗳️ Community Voting</h3>
          <p class="text-gray-600">Vote on local initiatives</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
