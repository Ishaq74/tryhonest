---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('nav.classifieds')}>
  <div class="space-y-6">
    <h1 class="text-4xl font-bold">{t('nav.classifieds')}</h1>

    <!-- Classifieds Categories -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <a href={`/${lang}/classifieds/jobs`} class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition text-center">
        <div class="text-4xl mb-2">💼</div>
        <h3 class="font-bold">{t('classifieds.jobs')}</h3>
      </a>
      <a href={`/${lang}/classifieds/realestate`} class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition text-center">
        <div class="text-4xl mb-2">🏠</div>
        <h3 class="font-bold">{t('classifieds.realestate')}</h3>
      </a>
      <a href={`/${lang}/classifieds/deals`} class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition text-center">
        <div class="text-4xl mb-2">🎁</div>
        <h3 class="font-bold">{t('classifieds.deals')}</h3>
      </a>
      <a href={`/${lang}/classifieds/services`} class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition text-center">
        <div class="text-4xl mb-2">🔧</div>
        <h3 class="font-bold">{t('classifieds.services')}</h3>
      </a>
    </div>

    <!-- Recent Classifieds -->
    <div class="space-y-4">
      <div class="flex justify-between items-center">
        <h2 class="text-2xl font-bold">Recent Listings</h2>
        <button class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
          Post an Ad
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { type: 'job', title: 'Software Developer', price: '€45K-60K/year', category: '💼' },
          { type: 'realestate', title: '2BR Apartment', price: '€1,200/month', category: '🏠' },
          { type: 'deal', title: 'Mountain Bike', price: '€450', category: '🎁' },
          { type: 'service', title: 'House Cleaning', price: '€25/hour', category: '🔧' },
          { type: 'job', title: 'Chef Position', price: '€35K/year', category: '💼' },
          { type: 'realestate', title: 'Studio for Rent', price: '€700/month', category: '🏠' },
        ].map((item, i) => (
          <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="h-48 bg-gradient-to-br from-blue-400 to-purple-500 flex items-center justify-center text-6xl">
              {item.category}
            </div>
            <div class="p-4">
              <div class="flex justify-between items-start mb-2">
                <h3 class="text-xl font-bold">{item.title}</h3>
                <span class="px-2 py-1 bg-blue-100 text-blue-800 rounded text-sm">{item.type}</span>
              </div>
              <p class="text-2xl font-bold text-green-600 mb-4">{item.price}</p>
              <button class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700">
                View Details
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
