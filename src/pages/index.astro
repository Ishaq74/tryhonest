---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="Annecy Guide">
  <div class="space-y-12">
    <!-- Hero Section -->
    <section class="text-center py-12">
      <h1 class="text-5xl font-bold mb-4">Welcome to Annecy Guide</h1>
      <p class="text-xl text-gray-600 mb-8">
        Your comprehensive multilingual guide to Annecy - Restaurants, Hotels, Events, Hiking & More
      </p>
      <div class="flex justify-center space-x-4">
        <a href={`/${lang}/locations`} class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">
          {t('nav.locations')}
        </a>
        <a href={`/${lang}/events`} class="bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700">
          {t('nav.events')}
        </a>
      </div>
    </section>

    <!-- Quick Links -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white p-6 rounded-lg shadow-md">
        <h2 class="text-2xl font-bold mb-4">{t('nav.locations')}</h2>
        <ul class="space-y-2">
          <li><a href={`/${lang}/locations/restaurants`} class="text-blue-600 hover:underline">{t('locations.restaurants')}</a></li>
          <li><a href={`/${lang}/locations/hotels`} class="text-blue-600 hover:underline">{t('locations.hotels')}</a></li>
          <li><a href={`/${lang}/locations/bnb`} class="text-blue-600 hover:underline">{t('locations.bnb')}</a></li>
          <li><a href={`/${lang}/locations/gites`} class="text-blue-600 hover:underline">{t('locations.gites')}</a></li>
          <li><a href={`/${lang}/locations/activities`} class="text-blue-600 hover:underline">{t('locations.activities')}</a></li>
          <li><a href={`/${lang}/locations/shops`} class="text-blue-600 hover:underline">{t('locations.shops')}</a></li>
        </ul>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-md">
        <h2 class="text-2xl font-bold mb-4">{t('nav.events')}</h2>
        <ul class="space-y-2">
          <li><a href={`/${lang}/events`} class="text-blue-600 hover:underline">{t('events.all')}</a></li>
          <li><a href={`/${lang}/events/festivals`} class="text-blue-600 hover:underline">{t('events.festivals')}</a></li>
          <li><a href={`/${lang}/events/live`} class="text-blue-600 hover:underline">{t('events.live')}</a></li>
        </ul>
        <h3 class="text-xl font-bold mt-6 mb-2">{t('nav.hiking')}</h3>
        <p class="text-gray-600">Explore hiking trails with GPX files and geolocation</p>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-md">
        <h2 class="text-2xl font-bold mb-4">{t('nav.classifieds')}</h2>
        <ul class="space-y-2">
          <li><a href={`/${lang}/classifieds/jobs`} class="text-blue-600 hover:underline">{t('classifieds.jobs')}</a></li>
          <li><a href={`/${lang}/classifieds/realestate`} class="text-blue-600 hover:underline">{t('classifieds.realestate')}</a></li>
          <li><a href={`/${lang}/classifieds/deals`} class="text-blue-600 hover:underline">{t('classifieds.deals')}</a></li>
          <li><a href={`/${lang}/classifieds/services`} class="text-blue-600 hover:underline">{t('classifieds.services')}</a></li>
        </ul>
      </div>
    </section>

    <!-- Features -->
    <section class="bg-white p-8 rounded-lg shadow-md">
      <h2 class="text-3xl font-bold mb-6">Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div>
          <h3 class="font-bold text-lg mb-2">🌍 Multi-language</h3>
          <p class="text-gray-600">Available in FR, EN, ES, DE, AR, ZH</p>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-2">♿ Filters</h3>
          <p class="text-gray-600">PMR, Hours, Online, Languages, Parking, WiFi</p>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-2">📍 Locations</h3>
          <p class="text-gray-600">Restaurants, Hotels, B&B, Gîtes, Activities, Shops</p>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-2">🎉 Events & Festivals</h3>
          <p class="text-gray-600">Discover local events and celebrations</p>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-2">🥾 Hiking Trails</h3>
          <p class="text-gray-600">GPX files with geolocation support</p>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-2">📰 Magazine & Articles</h3>
          <p class="text-gray-600">Local news and stories</p>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-2">👥 Community</h3>
          <p class="text-gray-600">Forums, Groups, Messages, Verified Profiles</p>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-2">💼 Pro Space</h3>
          <p class="text-gray-600">Manage Locations, E-commerce, Bookings, Analytics, Ads</p>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-2">🔒 GDPR Compliant</h3>
          <p class="text-gray-600">Data export and privacy controls</p>
        </div>
      </div>
    </section>

    <!-- Community Section -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white p-6 rounded-lg shadow-md">
        <h2 class="text-2xl font-bold mb-4">{t('nav.community')}</h2>
        <ul class="space-y-2">
          <li><a href={`/${lang}/community/forums`} class="text-blue-600 hover:underline">{t('community.forums')}</a></li>
          <li><a href={`/${lang}/community/groups`} class="text-blue-600 hover:underline">{t('community.groups')}</a></li>
          <li><a href={`/${lang}/community/messages`} class="text-blue-600 hover:underline">{t('community.messages')}</a></li>
        </ul>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-md">
        <h2 class="text-2xl font-bold mb-4">{t('nav.pro')}</h2>
        <ul class="space-y-2">
          <li><a href={`/${lang}/pro/dashboard`} class="text-blue-600 hover:underline">{t('pro.dashboard')}</a></li>
          <li><a href={`/${lang}/pro/locations`} class="text-blue-600 hover:underline">{t('pro.locations')}</a></li>
          <li><a href={`/${lang}/pro/bookings`} class="text-blue-600 hover:underline">{t('pro.bookings')}</a></li>
          <li><a href={`/${lang}/pro/analytics`} class="text-blue-600 hover:underline">{t('pro.analytics')}</a></li>
          <li><a href={`/${lang}/pro/ads`} class="text-blue-600 hover:underline">{t('pro.ads')}</a></li>
        </ul>
      </div>
    </section>
  </div>
</Layout>
