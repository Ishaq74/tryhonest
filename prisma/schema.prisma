generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Place {
  id           String   @id @default(uuid())
  name         String
  category     String
  subcategory  String?
  description  String   @db.Text
  address      String
  latitude     Float
  longitude    Float
  phone        String?
  email        String?
  website      String?
  images       String[]
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  priceLevel   Int?
  openingHours Json?
  attributes   String[]
  verified     Boolean  @default(false)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  reviews      Review[]
  
  @@index([category])
  @@index([featured])
  @@index([rating])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  category    String
  startDate   DateTime
  endDate     DateTime?
  location    String
  latitude    Float?
  longitude   Float?
  images      String[]
  organizer   String
  website     String?
  ticketUrl   String?
  price       String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  @@index([startDate])
  @@index([category])
  @@index([featured])
}

model Hike {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  distance    Float
  elevation   Float
  duration    Float
  difficulty  String
  startPoint  String
  latitude    Float
  longitude   Float
  images      String[]
  gpxFile     String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  @@index([difficulty])
  @@index([featured])
}

model Review {
  id        String   @id @default(uuid())
  placeId   String
  userId    String
  userName  String
  rating    Int
  comment   String   @db.Text
  images    String[]
  helpful   Int      @default(0)
  createdAt DateTime @default(now())
  
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([placeId])
  @@index([userId])
  @@index([createdAt])
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  avatar    String?
  level     Int      @default(1)
  points    Int      @default(0)
  verified  Boolean  @default(false)
  expert    Boolean  @default(false)
  joinedAt  DateTime @default(now())
  
  reviews   Review[]
  
  @@index([email])
}

model Article {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  excerpt     String
  author      String
  category    String
  tags        String[]
  images      String[]
  featured    Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([slug])
  @@index([category])
  @@index([publishedAt])
}

model Classified {
  id          String   @id @default(uuid())
  type        String
  title       String
  description String   @db.Text
  price       Float?
  location    String
  images      String[]
  contactName String
  contactEmail String
  contactPhone String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  
  @@index([type])
  @@index([active])
  @@index([createdAt])
}

model LiveEvent {
  id          String   @id @default(uuid())
  type        String
  title       String
  description String   @db.Text
  location    String?
  upvotes     Int      @default(0)
  downvotes   Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  
  @@index([type])
  @@index([expiresAt])
  @@index([createdAt])
}
